<!doctype html>
<html lang="en">
<head>
  <%
    const siteName = 'Jay Dynamic Solutions';
    const rawTitle = typeof title !== 'undefined' && title ? title : siteName;
    const pageTitle = rawTitle.toLowerCase().includes(siteName.toLowerCase()) ? rawTitle : `${rawTitle} | ${siteName}`;
    const pageDescription = typeof description !== 'undefined' && description ? description : 'Technology services, IT training, and internship programs in Wagholi, Pune.';
    const shouldNoIndex = (typeof noindex !== 'undefined' && noindex) || (typeof adminArea !== 'undefined' && adminArea);
    const schemaGraph = [
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': 'https://www.jdsolutionss.com/#organization',
        name: 'Jay Dynamic Solutions',
        legalName: 'Jay Dynamic Solutions Pvt.Ltd.',
        url: 'https://www.jdsolutionss.com/',
        logo: 'https://www.jdsolutionss.com/logo.jpeg',
        telephone: '+918308035049',
        email: 'info@jdsolutionss.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Shop No. 113, Rainbow Crossroad, Wagholi',
          addressLocality: 'Pune',
          addressRegion: 'Maharashtra',
          postalCode: '412207',
          addressCountry: 'IN'
        }
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': 'https://www.jdsolutionss.com/#website',
        name: siteName,
        url: 'https://www.jdsolutionss.com/',
        inLanguage: 'en-IN',
        publisher: { '@id': 'https://www.jdsolutionss.com/#organization' }
      }
    ];
    if (typeof canonical !== 'undefined' && canonical) {
      schemaGraph.push({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: pageTitle,
        description: pageDescription,
        inLanguage: 'en-IN',
        isPartOf: { '@id': 'https://www.jdsolutionss.com/#website' },
        publisher: { '@id': 'https://www.jdsolutionss.com/#organization' }
      });
    }
    const schemaJson = JSON.stringify(schemaGraph).replace(/</g, '\\u003c');
  %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <meta name="robots" content="<%= shouldNoIndex ? (typeof adminArea !== 'undefined' && adminArea ? 'noindex, nofollow' : 'noindex, follow') : 'index, follow' %>">
  <% if (typeof canonical !== 'undefined') { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:image" content="https://www.jdsolutionss.com/logo.jpeg">
  <meta property="og:image:alt" content="Jay Dynamic Solutions logo">
  <meta property="og:locale" content="en_IN">
  <% if (typeof canonical !== 'undefined') { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="https://www.jdsolutionss.com/logo.jpeg">
  <script type="application/ld+json"><%- schemaJson %></script>
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/enhancements.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/brand-palette.css">
</head>
<body class="<%= typeof adminArea !== 'undefined' && adminArea ? 'admin-area' : '' %>">
<% if (typeof message !== 'undefined' && message) { %><div class="flash"><i class="bi bi-check-circle"></i><%= message %></div><% } %>
